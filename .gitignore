# Agent state/session data (local to this directory, not config)
agent/
.claude/

# temp files
tmp/

# User customizations (auto-generated by Emacs)
custom.el

# emacs package artifacts
eln-cache
elpa

# Note: All state, data, and cache files have been migrated to XDG directories:
# - $XDG_STATE_HOME/emacs/ — auto-save-list, backup, recentf, projects, tramp, nov-places, ielm-history, .dap-breakpoints
# - $XDG_DATA_HOME/emacs/ — elpa, transient, tree-sitter, mason, projectile-bookmarks, forge-database.sqlite
# - $XDG_CACHE_HOME/emacs/ — eln-cache, url
# See docs/xdg-migration-* for details
