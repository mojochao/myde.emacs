# Agent state/session data (local to this directory, not config)
agent/
.claude/

# temp files
tmp/

# User customizations (auto-generated by Emacs)
custom.el

# emacs package artifacts
eln-cache

# Package directory (elpa) - stored in repo root for debugging/grepping
# Configured in myde/core-base/cfg.el to use user-emacs-directory
elpa

# Note: State, data, and cache files use XDG directories:
# - $XDG_STATE_HOME/emacs/ — auto-save-list, backup, recentf, projects, tramp, nov-places, ielm-history, .dap-breakpoints
# - $XDG_DATA_HOME/emacs/ — transient, tree-sitter, mason, projectile-bookmarks, forge-database.sqlite
# - $XDG_CACHE_HOME/emacs/ — eln-cache, url
# - ./elpa/ — packages (repo root for debugging/agent access)
