{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$PWD}/scripts/claude-tangle-hook.sh\" guard",
            "statusMessage": "Checking for edits to tangled elisp"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$PWD}/scripts/claude-tangle-hook.sh\" tangle",
            "statusMessage": "Tangling myde.org"
          }
        ]
      }
    ]
  }
}
